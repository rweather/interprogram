(1) TITLE 1D LIFE
(2) SYMBOLS FOR INTEGERS SIZE, I, G
(3) MAXIMUM SUBSCRIPTS GENX(71), GENY(67)
(4) COMPILE THE FOLLOWING INTERPROGRAM

    SET SIZE = 67

    # SEED THE RANDOM NUMBER GENERATOR WITH THE INPUT.  IF NO NUMBER
    # IS SUPPLIED, START THE SEED AT 1 INSTEAD.
PUNCH THE FOLLOWING CHARACTERS
ENTER THE RANDOM SEED (0..250) = ~~~~~
    INPUT SEED, GO TO *5, SET SEED = 1
*5

    # CREATE THE FIRST GENERATION RANDOMLY.
    SET I = SIZE
*10
    SET GENY(I) = 0
    EXECUTE PROCESS *50
    SUBTRACT 0.5
    IF THIS IS POSITIVE, SET GENY(I) = 1
    REPEAT FROM *10 I TIMES

    # SET THE EXTRA CELLS TO THE LEFT AND RIGHT TO PERMANENTLY DEAD.
    SET GENX(0) = 0
    SET GENX(1) = 0
    SET GENX(SIZE + 3) = 0
    SET GENX(SIZE + 4) = 0

    # OUTPUT 25 GENERATIONS AND THEN STOP.  ITERATES FROM 24 DOWN TO 0.
    SET G = 24
*20

    # COPY Y TO X AND PRINT THE CURRENT STATE OF THE BOARD.
    # NOTE: WE SCAN RIGHT-TO-LEFT BUT 1D LIFE IS SYMMETRIC SO IT DOESN'T MATTER.
    SET I = SIZE
*30
    TAKE GENY(I)
    REPLACE GENX(I+2)
    IF THIS IS ZERO, GO TO *35
PUNCH THE FOLLOWING CHARACTERS
*~~~~~
    GO TO *39
*35
PUNCH THE FOLLOWING CHARACTERS
 ~~~~~
*39
    REPEAT FROM *30 I TIMES
PUNCH THE FOLLOWING CHARACTERS

~~~~~

    # COMPUTE THE NEXT GENERATION.
    SET I = SIZE
*40
    TAKE GENX(I)
    ADD GENX(I+1)
    ADD GENX(I+3)
    ADD GENX(I+4)
    REPLACE N
    SET GENY(I) = 0
    TAKE GENX(I+2)
    IF THIS IS ZERO, GO TO *45
    TAKE N
    SUBTRACT 2
    IF THIS IS NEGATIVE, GO TO *49  # LESS THAN 2
    IF THIS IS ZERO, GO TO *48      # EQUAL TO 2
    SUBTRACT 2
    IF THIS IS NEGATIVE, GO TO *49  # EQUAL TO 3
    GO TO *48                       # EQUAL TO 4
*45
    TAKE N
    SUBTRACT 2
    IF THIS IS ZERO, GO TO *48      # EQUAL TO 2
    SUBTRACT 1
    IF THIS IS ZERO, GO TO *48      # EQUAL TO 3
    GO TO *49                       # EQUAL TO 0, 1, OR 4
*48
    SET GENY(I) = 1
*49
    REPEAT FROM *40 I TIMES

    REPEAT FROM *20 G TIMES
    GO TO *99

    # RANDOM NUMBER GENERATOR: SEED = (A * SEED + C) MOD M.
    # A = 33, C = 1, M = 251 TO KEEP THINGS WITHIN THE 20-BIT
    # MANTISSA OF THE CSIRAC'S FLOATING-POINT REPRESENTATION.
*50
    TAKE SEED
    MULTIPLY BY 33
    ADD 1
    # POOR MAN'S MOD 251 BY SUCCESSIVE SUBTRACTION.  THIS IS SLOW.
*51
    SUBTRACT 251
    IF THIS IS POSITIVE, GO TO *51
    ADD 251
    REPLACE SEED
    # CONVERT INTO A NUMBER BETWEEN 0 AND 1.
    MULTIPLY BY 0.0039840637 # 1/251
    END OF PROCESS DEFINITION

*99
END OF INTERPROGRAM
